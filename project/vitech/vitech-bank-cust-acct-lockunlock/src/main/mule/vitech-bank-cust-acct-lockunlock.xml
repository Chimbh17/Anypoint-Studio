<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:email="http://www.mulesoft.org/schema/mule/email"
	xmlns:snowflake="http://www.mulesoft.org/schema/mule/snowflake"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/snowflake http://www.mulesoft.org/schema/mule/snowflake/current/mule-snowflake.xsd
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd">
	<apikit:config
		name="vitech-bank-cust-acct-lockunlock-config"
		api="vitech-bank-cust-acct-lockunlock.raml"
		outboundHeadersMapName="outboundHeaders"
		httpStatusVarName="httpStatus" />
	<flow name="vitech-bank-cust-acct-lockunlock-main">
		<http:listener path="/api/*"
			config-ref="HTTP_Listener_config">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:router
			config-ref="vitech-bank-cust-acct-lockunlock-config" />
		<error-handler>
			<on-error-propagate type="APIKIT:BAD_REQUEST">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">400
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate type="APIKIT:NOT_FOUND">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">404
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate
				type="APIKIT:METHOD_NOT_ALLOWED">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">405
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">406
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate
				type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">415
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
			<on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">501
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
		</error-handler>
	</flow>
	<flow name="vitech-bank-cust-acct-lockunlock-console">
		<http:listener path="/console/*"
			config-ref="HTTP_Listener_config">
			<http:response
				statusCode="#[vars.httpStatus default 200]">
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:response>
			<http:error-response
				statusCode="#[vars.httpStatus default 500]">
				<http:body><![CDATA[#[payload]]]></http:body>
				<http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
			</http:error-response>
		</http:listener>
		<apikit:console
			config-ref="vitech-bank-cust-acct-lockunlock-config" />
		<error-handler>
			<on-error-propagate type="APIKIT:NOT_FOUND">
				<ee:transform doc:name="Transform Message">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus">404
						</ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
		</error-handler>
	</flow>
	<flow
		name="put:\AcctlockUnlock:application\json:vitech-bank-cust-acct-lockunlock-config">
		<logger level="INFO" doc:name="Logger" doc:id="36384022-55fd-4aec-a8ef-56ae88be157c" message="#['\n'] &#10;-----------------------&#10;#['\n']&#10;-----------------------&gt; API Lock and Unlock API trigger&#10;#['\n'] &#10;-----------------------&#10;#['\n']"/>
		<set-variable value="#[%dw 2.0&#10;output application/json&#10;var inp = []&#10;---&#10;inp &lt;&lt; payload reduce ((item, accumulator) -&gt; item )]" doc:name="Set Payload In Variable" doc:id="1d45ba2b-31e0-4b02-8f81-b264d2e64c2e" variableName="inpPayload"/>
		<snowflake:select doc:name="Verify Account In DB" doc:id="c1a71114-35ae-4f81-9df0-70c4dbf3ea94" config-ref="Snowflake_Config00">
			<snowflake:sql ><![CDATA[SELECT * FROM VITECH.BFS.BANK_TRANSACTIONS WHERE CUSTACCNUM = :accountNumber AND BANKNAME = :bankName ;

]]></snowflake:sql>
			<snowflake:input-parameters ><![CDATA[#[%dw 2.0
output application/java
---
{
	"accountNumber": vars.inpPayload.accountNum ,
	"bankName": vars.inpPayload.bank
}]]]></snowflake:input-parameters>
		</snowflake:select>
		<set-variable value="#[payload[0].MAILID as String]" doc:name="Set Email" doc:id="c40b01bb-c60f-463b-bfdf-8ea989331b7e" variableName="email"/>
		<choice doc:name="Choice" doc:id="e302e84b-9c6b-47fb-880d-9affdee40661" >
			<when expression='#[sizeOf(payload) == 1 &#10;and payload[0].ACCOUNTSTATUS == "Active" &#10;and vars.inpPayload.acctStatus == "Lock"&#10;&#10;//1. Update the DB As Deactive]'>
				<logger level="INFO" doc:name="Lock Status" doc:id="be567e78-bd05-4cbe-8885-9233340f1756" message="#['\n'] &#10;---------------------&#10;#['\n']&#10;---------------------&gt; Perform lock as status&#10;#['\n'] &#10;---------------------&#10;#['\n']"/>
				<snowflake:update doc:name="Update the DB As Deactive" doc:id="2889dd12-e8a7-45a0-abd2-00a962e7a327" config-ref="Snowflake_Config00">
					<snowflake:sql ><![CDATA[UPDATE VITECH.BFS.BANK_TRANSACTIONS
SET WRONGPIN = 0 ,
ACCOUNTSTATUS = 'Deactive'
WHERE CUSTACCNUM = :accountNumber and BANKNAME = :bankName ; ]]></snowflake:sql>
					<snowflake:input-parameters ><![CDATA[#[output application/java
---
{
	"accountNumber": vars.inpPayload.accountNum ,
	"bankName": vars.inpPayload.bank
	
}]]]></snowflake:input-parameters>
				</snowflake:update>
				<email:send doc:name="Send Lock Notification" doc:id="6e29a2f9-5e3f-48cd-8526-af2d99312849" config-ref="Email_SMTP_Config" fromAddress="${email.user}" subject='#["Account Locked of " ++ vars.inpPayload.bank &#10;as String ++ " bank"]'>
					<email:to-addresses >
						<email:to-address value="#[vars.email]" />
					</email:to-addresses>
					<email:body contentType="text/plain" encoding="UTF-8" >
						<email:content ><![CDATA[#["Your Account $(vars.inpPayload.accountNum as String) With Bank $(vars.inpPayload.bank as String) is Locked now."]]]></email:content>
					</email:body>
				</email:send>
				<ee:transform doc:name="Success For Lock" doc:id="9aa30436-9580-443b-a70e-751d6b6d1926" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Your Account $(vars.inpPayload.accountNum as String) With Bank $(vars.inpPayload.bank as String) is Locked now."
]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Payload" doc:id="256c8c16-9f7e-4b89-9af1-a8c503ba6aad" message="#['\n'] &#10;--------------------&#10;#['\n']&#10;#[payload]&#10;#['\n'] &#10;--------------------&#10;#['\n']"/>
			</when>
			<when expression='#[sizeOf(payload) == 1 &#10;and payload[0].ACCOUNTSTATUS == "Deactive" &#10;and vars.inpPayload.acctStatus == "Lock"&#10;&#10;//2. No need to update]'>
				<logger level="INFO" doc:name="Already Lock" doc:id="1adf521b-7f80-4b17-ad98-64c0b2c44327" message="#['\n'] &#10;---------------------&#10;#['\n']&#10;---------------------&gt; Account is already locked&#10;#['\n'] &#10;---------------------&#10;#['\n']"/>
				<ee:transform doc:name="Already Lock" doc:id="9c815ad6-f59e-4658-8303-0cef172fca44" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Your Account $(vars.inpPayload.accountNum as String) With $(vars.inpPayload.bank as String) bank is already Locked."
]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Payload" doc:id="8fb8ecb2-566a-463e-87f9-008fcc3a7e24" message="#['\n'] &#10;--------------------&#10;#['\n']&#10;#[payload]&#10;#['\n'] &#10;--------------------&#10;#['\n']" />
			</when>
			<when expression='#[sizeOf(payload) == 1 &#10;and payload[0].ACCOUNTSTATUS == "Deactive" &#10;and vars.inpPayload.acctStatus == "Unlock"&#10;&#10;//3. Update the DB As Active]'>
				<logger level="INFO" doc:name="Unlock Account" doc:id="91738233-d399-49db-be1f-1f854ca2fa57" message="#['\n'] &#10;---------------------&#10;#['\n']&#10;---------------------&gt; Perform Unlock as status.&#10;#['\n'] &#10;---------------------&#10;#['\n']"/>
				<snowflake:update doc:name="Update the DB As Active" doc:id="c341e5b2-b1be-4de3-97a6-5c22ce35298b" config-ref="Snowflake_Config00">
					<snowflake:sql ><![CDATA[UPDATE VITECH.BFS.BANK_TRANSACTIONS
SET WRONGPIN = 0 ,
ACCOUNTSTATUS = 'Active'
WHERE CUSTACCNUM = :accountNumber and BANKNAME = :bankName ; ]]></snowflake:sql>
					<snowflake:input-parameters ><![CDATA[#[output application/java
---
{
	"accountNumber": vars.inpPayload.accountNum ,
	"bankName": vars.inpPayload.bank	
}]]]></snowflake:input-parameters>
				</snowflake:update>
				<email:send doc:name="Send Unlock Notification" doc:id="de0485be-fe26-47c8-84e8-0a1d48b14a0d" config-ref="Email_SMTP_Config" fromAddress="${email.user}" subject='#["Account Unlocked of " ++ vars.inpPayload.bank &#10;as String ++ " bank"]'>
					<email:to-addresses>
						<email:to-address value="#[vars.email]" />
					</email:to-addresses>
					<email:body contentType="text/plain" encoding="UTF-8">
						<email:content><![CDATA[#["Your Account $(vars.inpPayload.accountNum as String) With Bank $(vars.inpPayload.bank as String) is Unlocked now."]]]></email:content>
					</email:body>
				</email:send>
				<ee:transform doc:name="Success For Unlock" doc:id="202d5a81-5834-4ee9-a6b2-c1b56b409db1" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  Status: "Your Account $(vars.inpPayload.accountNum as String) With $(vars.inpPayload.bank as String) bank is Unlocked Now."
} ]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Payload" doc:id="09dca935-70e4-4981-abdc-889b17c0ec32" message="#['\n'] &#10;--------------------&#10;#['\n']&#10;#[payload]&#10;#['\n'] &#10;--------------------&#10;#['\n']" />
			</when>
			<when expression='#[sizeOf(payload) == 1 &#10;and payload[0].ACCOUNTSTATUS == "Active" &#10;and vars.inpPayload.acctStatus == "Unlock"&#10;&#10;//4. No need to update]'>
				<logger level="INFO" doc:name="Already Active" doc:id="dfc64bc7-0987-4d32-99d9-4e3a0cb95808" message="#['\n'] &#10;---------------------&#10;#['\n']&#10;---------------------&gt;Account is already Active (unlocked)&#10;#['\n'] &#10;---------------------&#10;#['\n']"/>
				<ee:transform doc:name="Already Active" doc:id="1c890724-7d12-4777-aa97-863231ea6672" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Your Account $(vars.inpPayload.accountNum as String) With $(vars.inpPayload.bank as String) bank is already Active (unlock)."
]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Payload" doc:id="2b944b88-e897-4782-a091-6608bfe60219" message="#['\n'] &#10;--------------------&#10;#['\n']&#10;#[payload]&#10;#['\n'] &#10;--------------------&#10;#['\n']" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Account Doest Not Exist" doc:id="29673a2f-fa2d-45ef-a6c7-16e6eab06f52" message="#['\n'] &#10;---------------------&#10;#['\n']&#10;----------------------&gt;Account Doest Not Exist&#10;#['\n'] &#10;---------------------&#10;#['\n']"/>
				<ee:transform doc:name="Transform Message" doc:id="96ecd6d2-f0ba-4b20-823a-2c4957515cb9" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Account : " ++ vars.inpPayload.accountNum as String ++ " does not exist in bank of the " ++ vars.inpPayload.bank as String ++ " enter valid details."]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>

		</flow>
		
 <flow name="get:\getLockedAccts:vitech-bank-cust-acct-lockunlock-config">
		<logger level="INFO" doc:name="Locked Accounts" doc:id="591ee5a9-dd4c-486a-964a-c2e9ed90d345" message="#['\n']&#10;--------------&#10;#['\n']&#10;--------------&gt;Locked accounts flow triggered.&#10;#['\n']&#10;--------------&#10;#['\n']"/>
		<snowflake:select doc:name="Get Locked Accounts Based On Bank" doc:id="0f148125-a27d-4b97-aa4a-6d2667d61ba3" config-ref="Snowflake_Config00">
			<snowflake:sql ><![CDATA[SELECT * FROM VITECH.BFS.BANK_TRANSACTIONS
WHERE ACCOUNTSTATUS = :acountStatus  
AND BANKNAME = :bankName ;]]></snowflake:sql>
			<snowflake:input-parameters ><![CDATA[#[output application/java
---
{
acountStatus: "Deactive" , 
bankName: attributes.queryParams.bank
}]]]></snowflake:input-parameters>
		</snowflake:select>
		<ee:transform doc:name="Transform Message" doc:id="80b10aee-db61-4361-a067-d42df2e60493" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload map ( item , index) -> {
	customerName: item.CUSTNAME,
	bank: item.BANKNAME,
	"type": item.ACCOUNTTYPE,
	branchName: item.BRANCHNAME,
	accountNum: item.CUSTACCNUM,
	ifscCode: item.IFSCCODE,
	mailId: item.MAILID,
	cardStatus: item.ACCOUNTSTATUS
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="9c61fd0f-b930-44b2-979e-0be7fa6e97ae" message="#['\n']&#10;--------------------------------&#10;#['\n']&#10;&#10;#[payload]&#10;&#10;#['\n']&#10;--------------------------------&#10;#['\n']"/>

		</flow>
	</mule>
