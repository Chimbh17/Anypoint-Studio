<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:snowflake="http://www.mulesoft.org/schema/mule/snowflake"
	xmlns:email="http://www.mulesoft.org/schema/mule/email"
	xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/email http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd 
http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/snowflake http://www.mulesoft.org/schema/mule/snowflake/current/mule-snowflake.xsd"><apikit:config name="vitech-bank-customer-check-balance-config" api="vitech-bank-customer-check-balance.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="vitech-bank-customer-check-balance-main">
        <http:listener config-ref="http-vitech-bank-balance" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="vitech-bank-customer-check-balance-config" />
		<error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="vitech-bank-customer-check-balance-console">
        <http:listener config-ref="http-vitech-bank-balance" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="vitech-bank-customer-check-balance-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="Check-Balance-Gmail-Flow" doc:id="2c421d53-2f37-4d78-89d8-46935c755212" >
		<logger level="INFO" doc:name="Before Send Email" doc:id="75c30b93-2a18-4b9e-871f-5f3a55f60c93" message="#['\n'] &#10;----------------------&#10;#['\n']&#10;------------------&gt; Before sending email..&#10;#['\n'] &#10;----------------------&#10;#['\n']"/>
		<email:send doc:name="Send" doc:id="ccd4b67c-9cf1-487d-8015-683eddcf7866" config-ref="check-balance-gmailConfig" subject="#[payload.subject]" fromAddress="${email.user}">
			<email:to-addresses >
				<email:to-address value="#[vars.email]" />
			</email:to-addresses>
			<email:body contentType="text/plain" encoding="UTF-8" >
				<email:content ><![CDATA[#[payload.emailBody]]]></email:content>
			</email:body>
		</email:send>
		<logger level="INFO" doc:name="After Send Email" doc:id="9da22067-e1c3-448f-9a7d-cf788da54e2c" message="#['\n'] #['\n']&#10;After send email..&#10;#['\n'] #['\n']"/>
	</flow>
	<flow name="get:\checkbalance:vitech-bank-customer-check-balance-config">
  <logger level="INFO" doc:name="Start API" doc:id="092a0dbd-42f1-475d-bff8-1d9b7b6ca394" message="#['\n'] ------ #['\n']&#10;Check balance API startd&#10;#['\n'] ------ #['\n']"/>
  <set-variable value='#[%dw 2.0 output application/java&#10;---&#10;{&#10;	bankName: attributes.queryParams.bank ,&#10;	accountType: attributes.queryParams.acctType ,&#10;	accountNumber: attributes.queryParams.accountNum ,&#10;	atmPin: attributes.queryParams.atmPin&#10;}]' doc:name="Input Variable" doc:id="a2d06f9c-2d48-4c66-8c2e-40dd25d251fb" variableName="inputVariable"/>
		<snowflake:select doc:name="Select" doc:id="be8eb8ca-23dc-425b-a0d3-26422cfce8d0" config-ref="Snowflake_Config">
			<snowflake:sql ><![CDATA[SELECT * FROM VITECH.BFS.BANK_TRANSACTIONS
WHERE CUSTACCNUM =:accountNum AND BANKNAME =:bankName ;

]]></snowflake:sql>
			<snowflake:input-parameters ><![CDATA[#[%dw 2.0
output application/java
---
{
   "accountNum": vars.inputVariable.accountNumber ,
   "bankName": vars.inputVariable.bankName   
}


//	"accountNum": attributes.queryParams.accountNum , 
//	"bankName": attributes.queryParams.bank]]]></snowflake:input-parameters>
		</snowflake:select>
		<choice doc:name="Verify Account Exits  or Not" doc:id="28901eb4-3065-4b0c-887d-5ca2230098ba" >
			<when expression="#[sizeOf(payload) &gt;= 1 and payload.ACCOUNTSTATUS[0] as String == 'Active']">
				<logger level="INFO" doc:name="Record Found In Database With Active Status" doc:id="3f8e096b-f6bf-404b-9e3e-2623896dad99" message="#['\n'] &#10;---------&#10;#['\n']&#10;Record Found In Database&#10;#['\n'] &#10;---------&#10;#['\n']"/>
				<set-variable value="#[payload.MAILID[0]]" doc:name="Set Email" doc:id="49871ff8-2a9a-4005-9671-7791f5394a14" variableName="email" />
				<choice doc:name="Choice" doc:id="f4d4d214-6877-4ac7-8bf6-a613714c210c">
					<when expression="#[vars.inputVariable.atmPin == payload.ATMPIN[0] and (payload.WRONGPIN[0] == 2 or payload.WRONGPIN[0] == 1)]">
						<set-variable value="#[payload.TOTALBALANCE[0]]" doc:name="Set Total Balance" doc:id="1fc363c9-9cfa-476a-a0c4-0322d207351b" variableName="totalBalance"/>
						<snowflake:update doc:name="Set Pin To Default" doc:id="b974cc3b-533f-4a34-939f-895d98d39ced" config-ref="Snowflake_Config">
							<snowflake:sql><![CDATA[UPDATE VITECH.BFS.BANK_TRANSACTIONS
SET WRONGPIN = :attemptwrongPin ,
WHERE CUSTACCNUM = :accountNumber  AND BANKNAME = :bankName ;]]></snowflake:sql>
							<snowflake:input-parameters><![CDATA[#[output application/java
---
{
	attemptwrongPin: 0 ,
	accountNumber: vars.inputVariable.accountNumber ,
	bankName: vars.inputVariable.bankName
}]]]></snowflake:input-parameters>
						</snowflake:update>
						<ee:transform doc:name="Success Final Message" doc:id="6ed6564a-1173-4cc8-a311-910cec10b22b">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  Status: "Your total balance is: $(vars.totalBalance) 
of $(vars.inputVariable.bankName) bank on today's date: $(now() as Date)"
}

]]></ee:set-payload>
			</ee:message>
		</ee:transform>
					</when>
					<when expression="#[vars.inputVariable.atmPin == payload.ATMPIN[0] and payload.WRONGPIN[0] == 0]">
						<logger level="INFO" doc:name="Pin Match" doc:id="11269130-9ce1-48b4-921a-8262c75ccc96" message="#['\n']&#10;----------------&#10;#['\n']&#10;---------------- pin match and wrong pin is 0&#10;#['\n']&#10;----------------&#10;#['\n']"/>
						<ee:transform doc:name="Wrong Pin Is Zero" doc:id="c3043686-1160-4c7e-b859-d6cb62502439" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  Status: "Your total balance is: $(payload.TOTALBALANCE[0]) 
of $(vars.inputVariable.bankName) bank on today's date: $(now() as Date)"
}

]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<otherwise >
						<logger level="INFO" doc:name="Pin Not Matched" doc:id="2914ff1b-456f-4bef-bce0-871849b839f7" message="#['\n']&#10;----------- &#10;#['\n']&#10;pin not match"/>
						<set-variable value="#[payload.WRONGPIN[0] + 1]" doc:name="wrongPinAttempt" doc:id="5660fb93-259c-43c4-9988-4a12895028b6" variableName="wrongPinAttempt"/>
						<choice doc:name="Choice" doc:id="3e28707d-a456-464d-91dd-91d6249225a9">
							<when expression="#[vars.wrongPinAttempt == 3]">
								<logger level="INFO" doc:name="Wrong pin reach 3" doc:id="2276effb-a60f-4638-a129-e34ee36c15f1" message="#['\n']&#10;--------------&#10;#['\n']&#10;Wrong pin reach: 3&#10;#['\n']&#10;--------------&#10;#['\n']"/>
								<snowflake:update doc:name="Update To Lock For Wrong Pin" doc:id="e76a6312-f221-41cf-991e-aa944d0453bf" config-ref="Snowflake_Config" >
									<snowflake:sql ><![CDATA[UPDATE VITECH.BFS.BANK_TRANSACTIONS
SET WRONGPIN = :attemptwrongPin ,
 ACCOUNTSTATUS = :acctStatus
WHERE CUSTACCNUM = :accountNumber  AND BANKNAME = :bankName ;


]]></snowflake:sql>
									<snowflake:input-parameters ><![CDATA[#[output application/java
---
{
	attemptwrongPin: vars.wrongPinAttempt ,
	acctStatus:  'Locked'  ,
	accountNumber: vars.inputVariable.accountNumber ,
	bankName: vars.inputVariable.bankName
}]]]></snowflake:input-parameters>
								</snowflake:update>
								<ee:transform doc:name="Email Content" doc:id="93f6fef0-9a1d-47ba-864c-1f9e3e636444">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"subject": "Account Locked..!" ,
	"emailBody": "This is to inform you that Account has been locked due to 3 failed attempts.. please reach out nearest
branch of $(vars.inputVariable.bankName) to unlock..."
}



]]></ee:set-payload>
									</ee:message>
								</ee:transform>
								<flow-ref doc:name="Gmail Send Flow" doc:id="8757aeed-590e-4c60-adfc-f62849030fea" name="Check-Balance-Gmail-Flow"/>
								<ee:transform doc:name="Max Pin Try" doc:id="b79a1475-a196-4077-9c04-5f2e2edb46db" >
									<ee:message >
										<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
"Status": "Maximum attempt reached your " ++ vars.inputVariable.accountNumber ++ "account is temporaily locked please reached nearest bank"
}
]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</when>
							<otherwise >
								<logger level="INFO" doc:name="Login Attempt Failed" doc:id="0f3326c0-c473-46a1-b259-6c2ab7d1105a" message="#['\n']&#10;----------&#10;#['\n']&#10;Login Attempt Failed..&#10;#['\n']&#10;----------&#10;#['\n']"/>
								<snowflake:update doc:name="Update Wrong Pin " doc:id="72125cb6-9dd3-4ccc-a7d8-5b42199a38c1" config-ref="Snowflake_Config">
							<snowflake:sql><![CDATA[UPDATE VITECH.BFS.BANK_TRANSACTIONS
SET WRONGPIN = :attemptwrongPin
WHERE CUSTACCNUM = :accountNumber  AND BANKNAME = :bankName ;


]]></snowflake:sql>
							<snowflake:input-parameters><![CDATA[#[output application/java
---
{
	attemptwrongPin: vars.wrongPinAttempt ,
	accountNumber: vars.inputVariable.accountNumber ,
	bankName: vars.inputVariable.bankName
}]]]></snowflake:input-parameters>
						</snowflake:update>
								<ee:transform doc:name="Email Content" doc:id="0a39ea04-d45a-432c-b0a0-16f52f49c4d5">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
"subject": "failed Attempt..!" ,
"emailBody": "This is to inform you that there's failed attempt happened while transaction , Your account will be blocked after $((3 - vars.wrongPinAttempt) as Number) attempts"
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
								<flow-ref doc:name="Gmail Send Flow" doc:id="9424e70b-fb06-4578-a5df-910439e1f1bd" name="Check-Balance-Gmail-Flow"/>
								<ee:transform doc:name="Transform Message" doc:id="28c8d7da-ad36-4fa7-978c-34b1fb003a4d" >
									<ee:message >
										<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var attemptsLeft = 3 - vars.wrongPinAttempt
---
{
 "message": "Login attempt failed",
 "attemptsLeft": attemptsLeft
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</otherwise>
						</choice>
					</otherwise>
				</choice>
			</when>
			<when expression="#[sizeOf(payload) &gt;= 1 and payload.ACCOUNTSTATUS[0] as String != 'Active']">
				<logger level="INFO" doc:name="Account Status Not Active" doc:id="5535e718-287f-4c0b-86b3-eed6551d3470" message="#['\n'] &#10;--------------&#10;#['\n']&#10;Account status is not active &#10;#['\n'] &#10;--------------&#10;#['\n']"/>
				<ee:transform doc:name="Card Is Locked" doc:id="e10e6f56-0a57-4c1e-90d9-908f8b5894f4" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Account " ++ vars.inputVariable.accountNumber
++ " temporarilly block please visit nearest branch of " 
++ vars.inputVariable.bankName]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Record  Not Found In Database" doc:id="62757af5-ec72-462c-94e6-25a2978f97a0" message="#['\n'] &#10;---------&#10;#['\n']&#10;Record Not Found In Database&#10;#['\n'] &#10;---------&#10;#['\n']" />
				<ee:transform doc:name="Transform Message" doc:id="13d4a5d6-14f9-4072-9027-95ac68c89e7e" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
"message": "Account " ++ vars.inputVariable.accountNumber 
++ " does not exist , in " ++ vars.inputVariable.bankName
++ " bank please enter valid details." 
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
    
</flow>
</mule>
